rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role verification checking the users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'Admin' ||
        getUserData().role == 'Manager' ||
        request.auth.token.admin == true
      );
    }

    // --- Users Collection ---
    // Customers can read and update their own document. Admins can read and write all users.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Products Collection ---
    // Public read for customer catalog. Admin write for inventory management.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Categories Collection ---
    // Public read. Admin write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Orders Collection ---
    // Anyone can create an order.
    // Customers can read their own orders (matching userId or matching email/phone).
    // Admins can read, update (status change), and manage all orders.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        )
      ) || (
        // Allow customer lookup by order ID
        resource.data.id == orderId
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Notifications Collection ---
    // Only kitchen staff and admins have read/write access to system alerts.
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      // Allow order creation trigger to post a notification
      allow create: if true;
    }

    // --- Settings Collection ---
    // Central kitchen configuration and POS integration settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
