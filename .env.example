VITE_APP_NAME="Rambo Biriyani"
VITE_APP_DESCRIPTION="Bold Flavours. No Mercy. Real Firebase Powered Dum Operations."
VITE_API_BASE_URL="https://api.rambobiriyani.com/v1"
VITE_ENABLE_MOCK_API="false"
VITE_ADMIN_DEFAULT_EMAIL="admin@rambo.com"

# Firebase Client Configuration (replace with your Firebase project keys)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional Local Emulators Flag
VITE_USE_FIREBASE_EMULATORS="false"
